[TEMPLATE]
# ============================================================
# SkillSprint backend environment - copy to backend/.env and fill in.
# NEVER commit the real .env (already gitignored).
# ============================================================

# --- Database ---
# PostgreSQL (production target)
# DATABASE_URL=postgresql+psycopg://skillsprint:skillsprint@localhost:5432/skillsprint
# SQLite (lightweight local development only)
DATABASE_URL=sqlite:///./skillsprint.db

# --- JWT ---
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Password hashing cost (production default 12; tests may lower it) ---
BCRYPT_ROUNDS=12

# --- CORS (comma-separated origins; '*' is refused in production) ---
CORS_ORIGINS=http://localhost:5173

# --- AI (Gemini) — never expose to the frontend; AI endpoints 503 without it ---
GEMINI_API_KEY=

# --- AI rate limit: requests per user per minute on /api/ai/* endpoints ---
AI_RATE_LIMIT_PER_MINUTE=10

# --- Code execution sandbox ---
# Unset            → local subprocess executor (DEVELOPMENT ONLY — not a sandbox)
# Set in production → URL of an isolated sidecar implementing
#                      POST /execute {language, source, stdin, time_limit_ms}
CODE_EXECUTOR_URL=

# --- Admin seeding (python -m app.seed) ---
# Defaults: admin@skillsprint.com / ChangeMe!123 — ALWAYS override in production.
ADMIN_SEED_EMAIL=admin@skillsprint.com
ADMIN_SEED_PASSWORD=ChangeMe!123

# --- Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Security reminders ---
# JWT_SECRET_KEY must be a long random value in any non-local environment.
# CODE_EXECUTOR_URL must point to an isolated execution sidecar in production.
# CORS_ORIGINS must not be wildcarded in production.
# ADMIN_SEED_EMAIL / ADMIN_SEED_PASSWORD are only used when first seeding the
# admin account. Rotate them immediately after the first run in any non-local env.
